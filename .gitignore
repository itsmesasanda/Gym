# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/

# IDE
.idea/
.vscode/

# Dependencies — global catch-all
node_modules/

# env files — never commit real secrets
.env
**/.env
ai-services/**/.env
admin-panel/**/.env

# Keep examples visible
!.env.example
!**/.env.example

# Per-directory node_modules (kept for clarity alongside global rule)
frontend/node_modules/
backend/node_modules/
admin-panel/server-admin/node_modules/
admin-panel/client-admin/node_modules/

# Build artifacts & binaries
*.zip
frontend/.expo/
frontend/dist/
frontend/web-build/
