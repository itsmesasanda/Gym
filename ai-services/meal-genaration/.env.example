# API keys must be set as environment variables — never committed to version control
# Copy this file to .env and fill in real values for local development
# In production, set these as environment variables in your hosting platform (Railway, Render, etc.)

# Pinecone vector database
PINECONE_API_KEY=
PINECONE_INDEX_NAME=food-rag-index
PINECONE_ENVIRONMENT=us-east-1

# Ollama (local embedding model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=llama3.1:8b

# RAG tuning parameters
TOP_K_RESULTS=15
FINAL_MEALS=5
CALORIE_TOLERANCE=0.20

# Groq LLM
GROQ_API_KEY=
