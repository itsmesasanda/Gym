# API keys must be set as environment variables — never committed to version control
# Copy this file to .env and fill in real values for local development
# In production, set these as environment variables in your hosting platform (Railway, Render, etc.)

# OpenAI (used for embeddings)
OPENAI_API_KEY=

# Pinecone vector database
PINECONE_API_KEY=
PINECONE_INDEX=workouts

# Groq LLM
GROQ_API_KEY=

# Optional shared secret. When set, /generate, /validate and /chat require header
# `X-API-Key: <value>`. Set the SAME value in the backend's WORKOUT_RAG_API_KEY.
# Leave blank to keep the endpoints open (not recommended in production).
RAG_API_KEY=
