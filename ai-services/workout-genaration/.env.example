# API keys must be set as environment variables — never committed to version control
# Copy this file to .env and fill in real values for local development
# In production, set these as environment variables in your hosting platform (Railway, Render, etc.)

# OpenAI (used for embeddings)
OPENAI_API_KEY=

# Pinecone vector database
PINECONE_API_KEY=
PINECONE_INDEX=workouts

# Groq LLM
GROQ_API_KEY=
