# Copy this file to .env for local development.
# In production, set all values as environment variables in your hosting platform — never commit .env.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# MongoDB connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret for user auth — must be a long random string, never a dictionary word (required)
JWT_SECRET=

# JWT secret for admin auth — must be different from JWT_SECRET (required)
ADMIN_JWT_SECRET=

# Groq API key for AI Coach (required)
GROQ_API_KEY=

# Comma-separated list of allowed CORS origins for production (optional in dev)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=

# Python RAG service URLs (defaults shown)
RAG_SERVICE_URL=http://127.0.0.1:8000
MEAL_RAG_SERVICE_URL=http://127.0.0.1:8001

# Server port (optional, defaults to 5050)
PORT=5050
